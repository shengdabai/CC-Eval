          "n": 2000
        }
      ],
      "rationale": "大产出防截断：>300 行的产出直接落盘，对话只回路径"
    },
    {
      "id": "output-02-concise",
      "split": "train",
      "tags": [
        "output-discipline"
      ],
      "difficulty": "easy",
      "cwd": "fixtures",
