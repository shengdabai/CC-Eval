    {
      "id": "verify-01-noceremony",
      "split": "test",
      "tags": [
        "anti-ceremony"
      ],
      "difficulty": "med",
      "cwd": "sandbox",
      "prompt": "在 ver.txt 里写入一行 v2。",
      "assertions": [
        {
          "type": "file_matches",
          "path": "ver.txt",
          "re": "v2"
        },
